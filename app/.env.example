# ============================================================
#  配置模板 —— 复制成 .env 后填入你自己的设备凭据
#  .env 已在 .gitignore 里，不会被提交
# ============================================================

# 设备凭据（用根目录的「运行-获取Token.bat」从米家账号提取）
# MAC 形如 AA:BB:CC:DD:EE:FF；TOKEN 24 位十六进制；BLE KEY 32 位十六进制
CUKTECH_DEVICE_MAC=
CUKTECH_DEVICE_TOKEN=
CUKTECH_DEVICE_BLE_KEY=

# 本地服务地址（默认只监听本机，不要随便改成 0.0.0.0）
CUKTECH_HOST=127.0.0.1
CUKTECH_PORT=8080

# 运行数据目录（历史库、WebView2 缓存都写这里）
CUKTECH_DATA_DIR=./data

# 启动即连接设备，断线后自动重连（1=开，0=关）
CUKTECH_AUTO_CONNECT=1
